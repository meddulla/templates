{
	"name": "vite-react-template",
	"description": "A template for building a React application with Vite, Hono, and Cloudflare Workers",
	"cloudflare": {
		"label": "Vite React Template",
		"products": [
			"Workers"
		],
		"categories": [],
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/532a5378-9717-4964-385b-5fafd2160200/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/ec7f4be5-d1d6-4e94-0851-126341745400/preview",
		"publish": true
	},
	"dependencies": {
		"hono": "4.11.1",
		"react": "19.2.1",
		"react-dom": "19.2.1"
	},
	"devDependencies": {
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"typescript": "5.9.3",
		"vite": "^7.0.0",
		"wrangler": "4.88.0"
	},
	"private": true,
	"scripts": {
		"assets": "node scripts/gen-assets.mjs",
		"build": "vite build src/worker/index.ts --outDir dist/server && vite build src/react-app/main.tsx --outDir dist/client",
		"cf-typegen": "wrangler types",
		"check": "npm run typecheck && npm run build",
		"deploy": "wrangler deploy",
		"dev": "vite dev src/worker/index.ts",
		"typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json"
	},
	"type": "module"
}
